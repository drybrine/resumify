# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# QRIS (Indonesia) — string payload dari QRIS statis merchant
# Cara: buka app bank/e-wallet merchant → tampilkan QRIS → scan/decode ke string
# atau paste dari dashboard merchant (GoBiz, Dana Business, dll.)
# Contoh format: 00020101021126...6304XXXX
QRIS_STATIC_PAYLOAD=00020101021126...6304XXXX

# Auto-confirm webhook secret (Bearer token)
# POST /api/payments/webhook  Authorization: Bearer <secret>
# Body: { "amount": 49137 }  → match pending amount_idr → upgrade Pro
PAYMENT_WEBHOOK_SECRET=change-me-long-random-string

# Optional: local Chrome for PDF
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
